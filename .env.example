# Local API key for dashboard login + HTTP MCP Bearer auth
# Default if unset: atlas_local
ATLAS_BOOTSTRAP_KEY=atlas_local

# Database:
#   pglite          → embedded local DB in .data/atlas (default, no Docker)
#   pglite:.data/x  → custom PGlite directory
#   postgresql://…  → Neon or local Postgres
DATABASE_URL=pglite

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WORKSPACE_NAME=Agent Atlas
STALE_HOURS=24
